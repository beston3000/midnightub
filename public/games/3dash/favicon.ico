  <body class="dock-collapsed">
    <nav class="dock is-collapsed" aria-label="Primary">
      <div class="dock-header">
        <a class="dock-brand" href="/">
          <img
            class="dock-brand-icon"
            src="/assets/images/vlr.svg"
            alt="Velara"
          />
        </a>
        <button
          class="dock-toggle"
          id="dock-toggle"
          type="button"
          aria-label="Expand sidebar"
          aria-expanded="false"
        >
          <span class="material-symbols-outlined" aria-hidden="true">
            chevron_right
          </span>
        </button>
      </div>

      <div class="dock-divider"></div>

      <div class="dock-menu">
        <a class="dock-item" href="/">
          <span class="material-symbols-outlined" aria-hidden="true">home</span>
          <span class="dock-item-text">Home</span>
        </a>
        <a class="dock-item" href="/g">
          <span class="material-symbols-outlined" aria-hidden="true">
            sports_esports
          </span>
          <span class="dock-item-text">Games</span>
        </a>
        <a class="dock-item" href="/a">
          <span class="material-symbols-outlined" aria-hidden="true">apps</span>
          <span class="dock-item-text">Apps</span>
        </a>
        <a class="dock-item" href="/messages">
          <span class="material-symbols-outlined" aria-hidden="true">chat</span>
          <span class="dock-item-text">Messages</span>
        </a>
      </div>

      <div class="dock-divider"></div>

      <div class="dock-footer">
        <a class="dock-item" href="/auth" id="profile-link">
          <span class="material-symbols-outlined" aria-hidden="true">
            account_circle
          </span>
          <span class="dock-item-text">Profile</span>
        </a>
        <a class="dock-item" href="/friends">
          <span class="material-symbols-outlined" aria-hidden="true">
            people
          </span>
          <span class="dock-item-text">Friends</span>
        </a>
        <a class="dock-item" href="/settings">
          <span class="material-symbols-outlined" aria-hidden="true">
            settings
          </span>
          <span class="dock-item-text">Settings</span>
        </a>
      </div>
    </nav>
    <main class="center">
      <section class="hero error-hero">
        <h1>404</h1>
        <p class="error-copy">Page not found</p>
        <div class="quick-links error-actions">
          <a class="btn-community" href="/">Back to Home</a>
        </div>
      </section>
