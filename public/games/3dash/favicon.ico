    <script src="/js/theme.js" defer></script>
    <script src="/js/tab-cloak.js" defer></script>
    <script src="/js/debug.js" defer></script>
    <script src="/scripts/battery.js"></script>
    <script>
      const initDockToggleDirect = () => {
        const dock = document.querySelector(".dock");
        const dockToggle = document.getElementById("dock-toggle");
        if (dock && dockToggle) {
          const icon = dockToggle.querySelector(".material-symbols-outlined");
          const setState = (collapsed) => {
            dock.classList.toggle("is-collapsed", collapsed);
            document.body.classList.toggle("dock-collapsed", collapsed);
            dockToggle.setAttribute("aria-expanded", String(!collapsed));
            dockToggle.setAttribute(
              "aria-label",
              collapsed ? "Expand sidebar" : "Collapse sidebar",
            );
            if (icon) {
              icon.textContent = collapsed ? "chevron_right" : "chevron_left";
            }
          };
          dockToggle.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            setState(!dock.classList.contains("is-collapsed"));
          });
        }
      };
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initDockToggleDirect);
      } else {
        initDockToggleDirect();
      }
    </script>
  </body>
</html>
